{
  "name": "dlrobot-front",
  "version": "1.0.0",
  "description": "Vue.js frontend for ROS robot control with MQTT and map navigation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "thermal-proxy": "node thermal-proxy-server.js",
    "thermal-diagnostic": "node thermal-diagnostic.js",
    "ros2-api": "node ros2_api_server.js",
    "thermal-bridge": "node thermal_bridge_server.js",
    "simple-backend": "python3 simple_backend.py",
    "dev:simple": "concurrently \"npm run dev\" \"npm run simple-backend\"",
    "dev:thermal": "concurrently \"npm run dev\" \"npm run thermal-bridge\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run ros2-api\"",
    "dev:all:win": "concurrently \"npm run dev\" \"npm run ros2-api\""
  },
  "dependencies": {
    "axios": "^1.4.0",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "leaflet": "^1.9.4",
    "paho-mqtt": "^1.1.0",
    "pinia": "^2.1.6",
    "process": "^0.11.10",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.3",
    "concurrently": "^8.2.2",
    "vite": "^4.4.5",
    "ws": "^8.14.2",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  }
}
