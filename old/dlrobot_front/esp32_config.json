{
  "esp32": {
    "host": "192.168.1.100",
    "port": 3333,
    "timeout": 10
  },
  "websocket": {
    "port": 8765,
    "host": "0.0.0.0"
  },
  "mqtt": {
    "enabled": true,
    "broker": "localhost",
    "port": 1883,
    "topics": {
      "thermal": "esp32/thermal",
      "sensor": "esp32/sensor",
      "status": "esp32/status"
    }
  },
  "database": {
    "enabled": true,
    "path": "esp32_data.db",
    "backup_enabled": true,
    "backup_interval": 3600
  },
  "logging": {
    "level": "INFO",
    "file": "esp32_backend.log",
    "max_size": "10MB",
    "backup_count": 5
  },
  "data_processing": {
    "thermal": {
      "auto_calibration": true,
      "temperature_range": [-40, 150],
      "interpolation": "bilinear"
    },
    "sensor": {
      "smoothing": true,
      "smoothing_window": 5,
      "outlier_detection": true
    }
  }
}