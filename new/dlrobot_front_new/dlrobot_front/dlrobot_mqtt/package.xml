<?xml version="1.0"?>
<package format="2">
  <name>dlrobot_mqtt</name>
  <version>0.1.0</version>
  <description>MQTT bridge for publishing selected ROS topics to a front-end.</description>

  <maintainer email="todo@example.com">dlrobot</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export/>
</package>
